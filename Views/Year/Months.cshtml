@model List<YearMonth>

<h1>@ViewData["Title"]</h1>
<h2>Year: @ViewBag.YearId</h2>

<h3>Total Jobs: @ViewBag.TotalJobs</h3>
<ol class="list-group list-group-numbered">

    @foreach (var month in Model)
    {
        <li class="list-group-item">
            <a asp-action="Jobs" asp-route-yearId="@month.YearId" asp-route-monthId="@month.MonthId">@month.Month.Mon</a>
        </li>
    }


</ol>


